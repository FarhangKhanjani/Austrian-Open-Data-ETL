# Copy to .env and adjust. Never commit .env.

# Local development database (matches docker-compose.yml).
# In production (GitHub Actions) this comes from a GitHub Secret instead.
DATABASE_URL=postgresql://etl:etl_dev_password@localhost:5432/austria_etl

# Used by docker-compose.yml to create the local database.
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl_dev_password
POSTGRES_DB=austria_etl
POSTGRES_PORT=5432

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Seconds before an HTTP request to a source API is aborted.
HTTP_TIMEOUT_SECONDS=30
